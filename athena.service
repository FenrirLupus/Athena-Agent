[Unit]
Description=Athena — the autonomous agent server (24/7)
After=network.target
# Watchdog-style restart on unexpected exit
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
# `athena web` — the FastAPI door (GUI + MCP + FIFO) WITH the in-process
# loop (ConversationLoop + ServerLoop). Binds config's server.host:port.
# THE 08-15 PORTABILITY FIX: the ExecStart path is a TEMPLATE
# (@ATHEAN_BIN@) — install-service.sh substitutes the real ~/.local/bin
# path at install time, so the unit works on ANY machine.
ExecStart=@ATHENA_BIN@/athena web
Restart=on-failure
RestartSec=5
# Auto-restart on crash; stop cleanly on shutdown (SIGTERM handled in main.py)
KillSignal=SIGTERM
TimeoutStopSec=15

[Install]
WantedBy=default.target
