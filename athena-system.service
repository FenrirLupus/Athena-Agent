[Unit]
Description=Athena — the autonomous agent server (24/7) — SYSTEM-WIDE
# The Operator's spec: Athena's SERVICE is system-wide (plain `systemctl`),
# while `athena` the COMMAND is the user's manual launcher (like docker
# or distrobox). This unit runs the server/runtime as a daemon.
After=network.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
# THE 08-15 PORTABILITY FIX: the system unit is a TEMPLATE — install
# substitutes @ATHENA_USER@ + @ATHENA_BIN@ at install time (the same
# entry the user runs manually; the unit makes it a system service).
User=@ATHENA_USER@
ExecStart=@ATHENA_BIN@/athena web
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
